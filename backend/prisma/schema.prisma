datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

/// System user access roles.
/// Used for role-based access control (RBAC) across ERP modules.
enum Role {
  ADMIN
  SALES_USER
}

/// Lifecycle states of a customer sales enquiry.
enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

/// Lifecycle states of a formal price quotation.
enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

/// Lifecycle states of an agreed sales order.
enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

// ==========================================
// CORE MASTER ENTITIES
// ==========================================

/// Application user record.
/// Design Decision:
/// Password is explicitly named 'passwordHash' to ensure plaintext credentials
/// are never stored, enforcing one-way cryptographic hashing (e.g. bcrypt/argon2).
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role        @default(SALES_USER)
  enquiries    Enquiry[]   @relation("UserEnquiries")
  quotations   Quotation[] @relation("UserQuotations")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([role])
}

/// Business client/customer master record.
/// Referenced throughout the enquiry -> quotation -> order sales pipeline.
model Customer {
  id          String       @id @default(uuid())
  name        String
  email       String?
  phone       String?
  address     String?
  gstin       String?
  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
}

/// Catalog product master record.
/// Design Decision:
/// basePrice uses Decimal(12, 2) rather than Float to eliminate IEEE-754 binary
/// floating-point rounding errors in commercial calculations.
model Product {
  id              String           @id @default(uuid())
  productCode     String           @unique
  name            String
  category        String
  unit            String // e.g., PCS, KG, MTR, BOX
  basePrice       Decimal          @db.Decimal(12, 2)
  inventory       Inventory?
  enquiryItems    EnquiryItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([category])
}

/// Warehouse inventory tracking per product.
///
/// Design Decision & Technical Interview Note:
/// 1. We strictly do NOT store 'availableQuantity' as a persistent column. Storing both
///    physical, reserved, and available fields creates redundancy and risks data desynchronization
///    anomalies during concurrent transactions.
/// 2. Available quantity is always dynamically derived in business logic as:
///    availableQuantity = physicalQuantity - reservedQuantity.
/// 3. In the service layer, updates will use PostgreSQL SELECT ... FOR UPDATE row-level
///    locking to prevent race conditions during reservation.
model Inventory {
  id               String   @id @default(uuid())
  productId        String   @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  physicalQuantity Int      @default(0) // Physical count on hand (must be >= 0)
  reservedQuantity Int      @default(0) // Quantity locked for confirmed orders (must be >= 0 and <= physicalQuantity)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ==========================================
// SALES WORKFLOW ENTITIES
// ==========================================

/// Initial sales enquiry submitted by or on behalf of a customer.
model Enquiry {
  id            String        @id @default(uuid())
  enquiryNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdById   String?
  createdBy     User?         @relation("UserEnquiries", fields: [createdById], references: [id], onDelete: SetNull)
  enquiryDate   DateTime      @default(now())
  requiredDate  DateTime?
  notes         String?
  status        EnquiryStatus @default(NEW)
  items         EnquiryItem[]
  quotations    Quotation[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
  @@index([createdById])
  @@index([status])
}

/// Line items associated with an enquiry.
/// Uses onDelete: Cascade so cleaning up an enquiry removes its child lines.
model EnquiryItem {
  id        String   @id @default(uuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int // Must be > 0
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enquiryId])
  @@index([productId])
}

/// Commercial price quotation provided to the customer.
///
/// Design Decision:
/// Stores pre-computed financial totals (subtotal, discounts, tax, grand total)
/// for auditability, point-in-time financial consistency, and performance when querying lists.
model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique
  enquiryId       String
  enquiry         Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdById     String?
  createdBy       User?           @relation("UserQuotations", fields: [createdById], references: [id], onDelete: SetNull)
  validUntil      DateTime
  status          QuotationStatus @default(DRAFT)
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @db.Decimal(12, 2)
  items           QuotationItem[]
  salesOrder      SalesOrder?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([enquiryId])
  @@index([customerId])
  @@index([createdById])
  @@index([status])
}

/// Detailed line item on a quotation with pricing, discount, and tax.
///
/// Design Decision:
/// All calculations are validated on the backend. Frontend-supplied grand totals
/// are never trusted. Line amount = (quantity * unitPrice) * (1 - discountPercent/100) * (1 + gstPercent/100).
model QuotationItem {
  id              String    @id @default(uuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity        Int // Must be > 0
  unitPrice       Decimal   @db.Decimal(12, 2)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2) // e.g. 10.00 for 10%
  gstPercent      Decimal   @default(0) @db.Decimal(5, 2) // e.g. 18.00 for 18%
  lineAmount      Decimal   @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([quotationId])
  @@index([productId])
}

/// Confirmed commercial Sales Order.
///
/// Design Decision & Technical Interview Note:
/// 1. quotationId is marked @unique to strictly enforce at the database level that
///    a single quotation can generate AT MOST one sales order, preventing double-ordering bugs.
/// 2. onDelete: Restrict protects financial audit trails; an active sales order cannot
///    be silently deleted if referenced by dispatches or referencing a customer.
model SalesOrder {
  id          String           @id @default(uuid())
  orderNumber String           @unique
  quotationId String           @unique
  quotation   Quotation        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderDate   DateTime         @default(now())
  totalAmount Decimal          @db.Decimal(12, 2)
  status      SalesOrderStatus @default(PENDING)
  items       SalesOrderItem[]
  dispatches  Dispatch[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([customerId])
  @@index([status])
}

/// Line items on a confirmed sales order.
model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int // Must be > 0
  unitPrice    Decimal    @db.Decimal(12, 2)
  lineAmount   Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([salesOrderId])
  @@index([productId])
}

/// Goods dispatch / shipment record.
///
/// Design Decision & Technical Interview Note:
/// Dispatches verify that physical shipment does not exceed previously reserved inventory.
/// Dispatch records are permanently linked to the Sales Order to ensure strict delivery traceability.
model Dispatch {
  id             String     @id @default(uuid())
  dispatchNumber String     @unique
  salesOrderId   String
  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  dispatchDate   DateTime   @default(now())
  vehicleNumber  String
  driverName     String
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([salesOrderId])
}
